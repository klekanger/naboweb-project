# -----------------------------------------------------------------------------
# NaboWeb – Next.js app environment variables
# Copy this file to `.env.local` and fill in the values:
#   cp .env.example .env.local
# Never commit real secrets.
# -----------------------------------------------------------------------------

# --- Site --------------------------------------------------------------------
# Public base URL of the site (used in links in email alerts)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Sanity ------------------------------------------------------------------
# Find these at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# Optional – defaults to 2025-05-23
NEXT_PUBLIC_SANITY_API_VERSION=2025-05-23
# URL where Sanity Studio runs (used for Presentation / Visual Editing links)
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# API token with "Viewer" permissions (draft mode, live preview, email alerts)
SANITY_VIEWER_TOKEN=
# API token with "Editor" permissions (mutations from API routes)
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# --- Clerk (authentication) --------------------------------------------------
# Find these at https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Where invited users land after signing in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# --- Upstash Redis (email alert scheduling state) ----------------------------
# Find these at https://console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# --- Email alerts (AWS SES over SMTP, port 465) ------------------------------
AWS_SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
AWS_SMTP_USER=
AWS_SMTP_PASSWORD=
AWS_SMTP_FROM_EMAIL=noreply@example.com

# --- Secrets for /api/send-email-alerts --------------------------------------
# Generate with e.g. `openssl rand -hex 32`
# CRON_SECRET is sent automatically by Vercel Cron as a Bearer token
CRON_SECRET=
# Bearer token for triggering email alerts manually
EMAIL_SECRET_TOKEN=
