{
  "name": "naboweb-monorepo",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm -r run dev",
    "dev:studio": "pnpm --filter @naboweb/studio dev",
    "build": "pnpm --filter @naboweb/nextjs-app build",
    "build:studio": "pnpm --filter @naboweb/studio build",
    "start": "pnpm --filter @naboweb/nextjs-app start",
    "lint": "pnpm --filter @naboweb/nextjs-app lint",
    "test": "pnpm --filter @naboweb/nextjs-app test",
    "coverage": "pnpm --filter @naboweb/nextjs-app coverage",
    "typegen": "pnpm --filter @naboweb/studio typegen"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "basic-ftp": ">=5.2.0",
      "fast-xml-parser": ">=5.5.7",
      "follow-redirects": ">=1.16.0"
    },
    "patchedDependencies": {
      "next-themes@0.4.6": "patches/next-themes@0.4.6.patch"
    }
  }
}
