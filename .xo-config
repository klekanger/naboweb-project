{
  "rules": {
    "@typescript-eslint/naming-convention": [
      "error",
      {
        "selector": "variable",
        "format": [
          "camelCase",
          "UPPER_CASE"
        ]
      }
    ],
    "unicorn/filename-case": [
      "error",
      {
        "cases": {
          "pascalCase": true,
          "kebabCase": true
        }
      }
    ],
    "import/extensions": [
      "error",
      "never",
      {
        "svg": "always",
        "css": "always"
      }
    ],
    "n/file-extension-in-import": [
      "error",
      "always",
      {
        ".js": "never",
        ".ts": "never",
        ".tsx": "never",
        ".mts": "never",
        ".cts": "never"
      }
    ],
    "import/order": [
      "off",
      {}
    ],
    "n/prefer-global/process": [
      "off"
    ],
    "unicorn/no-negated-condition": [
      "off"
    ],
    "unicorn/prevent-abbreviations": [
      "error",
      {
        "allowList": {
          "generateStaticParams": true,
          "req": true,
          "InfoBoxProps": true,
          "props": true,
          "Props": true,
          "AlertUserProps": true,
          "BlogCollectionParams": true,
          "BlogParams": true,
          "param": true
        }
      }
    ]
  }
}
