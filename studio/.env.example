# -----------------------------------------------------------------------------
# NaboWeb – Sanity Studio environment variables
# Copy this file to `.env.local` and fill in the values:
#   cp .env.example .env.local
# Only variables prefixed with SANITY_STUDIO_ are exposed to the Studio bundle.
# -----------------------------------------------------------------------------

# Find these at https://www.sanity.io/manage (must match the Next.js app)
SANITY_STUDIO_SANITY_PROJECT_ID=your-project-id
SANITY_STUDIO_SANITY_DATASET=production

# URL of the Next.js app, used by the Presentation tool for live preview
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000

# Optional – defaults to 2025-05-23
SANITY_API_VERSION=2025-05-23
